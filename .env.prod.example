# Ambiente do docker-compose.prod.yml. Copie para .env.prod (fora do git) e preencha.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Imagem (padrão: a publicada no GHCR; `build: .` gera localmente com o mesmo nome)
# APP_IMAGE=ghcr.io/cainan-bn/commerce-agents:1.0.0

# Obrigatórios: sem eles o compose falha antes de subir.
# Use só letras, números, - e _ na senha do Postgres: ela entra na DATABASE_URL.
POSTGRES_PASSWORD=
WEB_SESSION_SECRET=
PANEL_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# POSTGRES_USER=commerce
# POSTGRES_DB=commerce

# Escala (ADR 0019): partições dos tópicos, réplicas do worker e processos da API.
KAFKA_PARTITIONS=3
WORKER_REPLICAS=2
API_WORKERS=2

# Modo demonstração (ADR 0020): nunca ligue em produção real.
DEMO_MODE=false

# LLM (ADR 0015/0017/0019). Sem LLM_MODEL (ou LLM_PROVIDER=recorded), o LLM fica não configurado.
# Demonstração gravada: LLM_PROVIDER=recorded e LLM_CASSETTE=<arquivo do cassete>.
# Chave própria: LLM_PROVIDER=openai-compatible, LLM_MODEL, LLM_API_KEY (e LLM_BASE_URL).
# Deixe comentadas as que não usar: variável vazia conta como definida.
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_CASSETTE=
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_S=60
# Secundário opcional (com ele, o primário não repete tentativas):
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=

# Canais da Meta (opcionais; vazios desligam a verificação dos webhooks correspondentes)
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=

# Portas no host
# API_HOST_PORT=8000
# GRAFANA_HOST_PORT=3001
# JAEGER_HOST_PORT=16686
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_ADMIN_USER=admin
# LOG_LEVEL=INFO
